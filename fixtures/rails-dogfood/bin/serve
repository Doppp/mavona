#!/usr/bin/env ruby
ENV["RAILS_ENV"] = "test"
ENV["DOGFOOD_BROWSER"] = "1"
abort "External database configuration is forbidden" if ENV.key?("DATABASE_URL")
require "rbconfig"
Dir.chdir(File.expand_path("..", __dir__)) do
  abort "Database preparation failed" unless system(RbConfig.ruby, "bin/rails", "db:prepare")
  abort "Fixture seeding failed" unless system(RbConfig.ruby, "bin/rails", "db:seed")
  exec RbConfig.ruby, "bin/rails", "server", "--binding", "127.0.0.1", "--port", ENV.fetch("DOGFOOD_PORT", "4317")
end
